{
  "compilerOptions": {
    /* Target & Environment */
    "target": "ES2022",
    "lib": ["ES2022"],

    /* Modules & Resolution */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* Interop & Compatibility */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    /* Strictness & Code Quality */
    "strict": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "frontend"]
}